# Copy to .env (gitignored). Required for the LLM Explore path and for Reflect.
# The template Explore path, the QM driver and every check under scripts/ run without it.

# OpenAI-compatible endpoint used by loop/pi_call.sh and loop/fully_auto/client.py.
# The endpoint is registered with pi by .agentcfg/extensions/provider.js under the
# provider id below; override PI_PROVIDER only if you register it under another name.
BASE_URL=https://your-endpoint.example.com/v1
API_KEY=replace-me
MODEL_NAME=your-model
# PI_PROVIDER=reaxevolve

# Optional overrides; defaults are resolved in scripts/lib/chem_paths.py
# ORCA_DIR=/opt/orca_6_1_1_linux_x86-64_shared_openmpi418_nodmrg
# XTB_BIN=/opt/xtb/bin/xtb
# CHEM_PYTHON=/opt/conda/envs/chem/bin/python3

# Supplementary TSBench lane only (see tsbench/README.md); not read by the main loop.
# TSBENCH_ROOT=/path/to/TSBench-main
